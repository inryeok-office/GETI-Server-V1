# Auto detect text files and normalize line endings on checkout
* text=auto eol=lf

# Gradle wrapper script must always use LF, even on Windows
/gradlew text eol=lf

# Windows batch/command scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source & config files use LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.properties text eol=lf

# Binary files must not be modified
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
