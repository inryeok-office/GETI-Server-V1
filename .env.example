# 이 파일은 Spring Boot가 자동으로 읽지 않는다. Spring Boot는 .env 또는 .env.example을
# Config Data 소스로 지원하지 않는다. 이 파일은 로컬 개발자가 어떤 환경 변수를 셸에
# export하거나 IDE Run Configuration에 등록해야 하는지 안내하는 문서용 Template이다.
#
# 값을 채운 .env 파일을 만들어 사용해도 되지만, 실제로 애플리케이션에 전달하려면
# 셸에서 값을 export하거나(예: `export $(grep -v '^#' .env | xargs)`) IDE/실행 스크립트에서
# 환경 변수로 주입해야 한다.
#
# 실제 Secret 값을 이 파일에 채우지 않는다. .env(실제 값이 채워진 파일)는 .gitignore에
# 의해 Commit되지 않는다.

# Spring Boot 표준 환경 변수. local, test, prod 중 하나를 지정한다.
# 값을 지정하지 않으면 공통 설정(application.yaml)만 적용된다.
SPRING_PROFILES_ACTIVE=local

# --- Spring Boot Application → Persistence 연결 ---
#
# local Profile(application-local.yaml)은 아래와 동일한 기본값을 가지고 있어, Host에서
# 직접 `bootRun`으로 실행하면 이 값을 지정하지 않아도 아래 Docker Compose 기본 인프라에
# 그대로 연결된다. prod Profile(application-prod.yaml)은 기본값이 없어 아래 변수를
# 지정하지 않으면 기동에 실패한다(Fail-Fast).
#
# `docker compose --profile app`으로 Spring Boot까지 Container로 실행할 때는 compose.yaml이
# POSTGRES_*/REDIS_HOST 값으로 DATABASE_URL 등을 자체적으로 구성하므로 이 값들을 그대로
# 쓰지 않는다.

# PostgreSQL(JDBC URL)
DATABASE_URL=jdbc:postgresql://localhost:5432/geti
DATABASE_USERNAME=geti
DATABASE_PASSWORD=geti-local-only

# Redis
REDIS_HOST=localhost
# REDIS_PORT는 아래 Docker Compose 섹션에 정의되어 있으며, Host 노출 Port와
# Application 연결 Port로 함께 쓰인다.
# Local 인프라는 인증을 사용하지 않으므로 비워 둔다.
REDIS_PASSWORD=

# --- Auth (JWT / Google OAuth2) ---
#
# JWT_SECRET은 Access/Refresh Token 서명에 사용하는 대칭키다. local Profile은 개발 전용
# 기본값을 가지고 있어(application-local.yaml) 비워둬도 기동은 되지만, prod Profile은
# 기본값이 없어 반드시 지정해야 한다(Fail-Fast). 최소 256bit(32byte) 이상의 무작위 문자열을
# 사용한다. 실제 Secret 값은 이 파일(.env.example)에 채우지 않는다.
JWT_SECRET=

# Google Cloud Console에서 발급받은 OAuth 2.0 Client(교직원 로그인). local Profile은 비워둬도
# 기동되지만(빈 값이면 Google 로그인 자체가 실패할 뿐 App은 정상 기동), prod Profile은 필수다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console의 승인된 Redirect URI와 정확히 일치해야 한다.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# DataGSM(DG) OAuth Client(학생·졸업생 로그인). Google과 동일하게 local Profile은 비워둬도 App은
# 정상 기동하고(빈 값이면 DG 로그인만 실패), prod Profile은 필수다. client_secret 방식(Backend가
# client_secret으로 직접 Token 교환)이라 CLIENT_SECRET을 반드시 안전하게 관리한다.
DG_CLIENT_ID=
DG_CLIENT_SECRET=
# DG 인증 서버에 등록된 Redirect URI와 정확히 일치해야 한다.
DG_REDIRECT_URI=http://localhost:8080/api/v1/auth/dg/callback
# DG 인증 서버(authorize/token)와 리소스 서버(userinfo) Base URL. 값을 비워두면 아래 Profile
# 기본값(local=개발 서버, prod=운영 서버)을 사용한다.
DG_AUTHORIZATION_SERVER=
DG_RESOURCE_SERVER=

# --- Collector(외부 채용 공고 수집) ---
#
# *_ENABLED가 false거나 *_SERVICE_KEY/*_ACCESS_KEY가 비어 있으면 기동은 정상적으로 되고 해당
# Provider만 configured=false로 비활성 취급된다(Fail-Fast 아님). 실제 인증키는 이 파일에
# 채우지 않는다 — 로컬에서는 .gitignore로 제외되는 별도 파일(예: .env.collector.local)에만
# 채워 셸에 export한다(docs/development/configuration.md 참고).
COLLECTOR_MMA_ENABLED=false
COLLECTOR_MMA_SERVICE_KEY=
COLLECTOR_JOB_ALIO_ENABLED=false
COLLECTOR_JOB_ALIO_SERVICE_KEY=
COLLECTOR_CLEAN_EYE_ENABLED=false
COLLECTOR_CLEAN_EYE_SERVICE_KEY=
COLLECTOR_NARA_ILTEO_ENABLED=false
COLLECTOR_NARA_ILTEO_SERVICE_KEY=
COLLECTOR_SARAMIN_ENABLED=false
COLLECTOR_SARAMIN_ACCESS_KEY=

# 일일 자동 수집 Scheduler 활성화 여부. 기본 false(수동 실행 API와 Test는 영향받지 않는다).
COLLECTOR_EXTERNAL_SCHEDULER_ENABLED=false

# 화면 검증용 개발 Fixture 공고 자동 적재 여부. local/develop Profile에서만 의미가 있고,
# prod/production Profile에서 true로 설정하면 애플리케이션이 기동을 거부한다.
COLLECTOR_SEED_ENABLED=false

# Collector가 실제 Provider 수집으로 새로 등록(CREATED)한 공고에 대한 Discord Webhook 알림
# (Issue #62 확장 범위). 세 값 모두 설정하지 않아도 애플리케이션·Collector·공고 등록은
# 정상 동작하고 알림만 비활성 상태로 유지된다. CD 배포 알림(DISCORD_CD_WEBHOOK_URL, CI/CD 전용)과는
# 완전히 별개의 Secret이다 — 절대 같은 값으로 재사용하지 않는다. 실제 Webhook URL은 이 파일에
# 채우지 않는다(docs/development/cd.md 참고).
DISCORD_JOB_NOTIFICATION_ENABLED=false
DISCORD_JOB_WEBHOOK_URL=
# 해당 Provider의 최초 성공 수집(초기 대량 수집)에서도 공고별 개별 알림을 보낼지 여부. 기본
# false — 최초 수집은 수백 건일 수 있어 Discord Rate Limit/스팸을 피한다.
DISCORD_JOB_NOTIFY_INITIAL_IMPORT=false

# --- File Storage (Object Storage) ---
#
# local은 아래 Docker Compose 섹션의 MinIO를 그대로 쓴다(application-local.yaml이
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD/MINIO_API_PORT를 재사용하므로 아래 두 값을 비워둬도
# 정상 기동한다). prod Profile은 기본값이 없어 반드시 지정해야 한다(Fail-Fast).
#
# 운영에서는 Access Key를 환경 변수로 주입하지 않는다. application-prod.yaml이 access-key/
# secret-key를 선언하지 않아 AWS SDK가 EC2 Instance Profile(IAM Role)에서 자격증명을
# 받아오기 때문이다. 장기 Access Key를 서버에 두지 않기 위한 구성이다.
# (선행 조건: 앱이 Container 안에서 돌아 EC2 Metadata hop limit이 2 이상이어야 한다.
#  docs/file/file-domain-plan.md 14.3 참고)
FILE_STORAGE_BUCKET=geti-local
# AWS Region. local(MinIO)은 application-local.yaml이 us-east-1로 고정하므로 무시된다.
FILE_STORAGE_REGION=ap-northeast-2

# --- Web / API (CORS) ---
#
# 비워두면(기본값) CORS Mapping 자체를 등록하지 않는다. 이는 "모든 Origin을 허용"이
# 아니라 "CORS 비활성화"를 뜻하며 Browser의 기본 Same-Origin 정책만 적용된다. 실제 Web
# Client Origin이 정해지면 아래 주석을 해제하고 실제 값으로 채운다. Wildcard(`*`)와
# Credential 허용(APP_WEB_CORS_ALLOW_CREDENTIALS=true)을 함께 사용하지 않는다.
# APP_WEB_CORS_ALLOWED_ORIGINS=https://example.com

# --- Docker Compose(compose.yaml) 로컬 인프라 ---
#
# 아래 값은 compose.yaml에도 동일한 기본값이 설정되어 있어 .env 없이
# `docker compose up -d`를 실행해도 그대로 동작한다. 이 파일 또는 실제 .env에
# 값을 채우면 Docker Compose가 자동으로 읽어(Compose는 Spring Boot와 무관하게
# 실행 디렉터리의 .env를 변수 치환에 사용한다) 아래 기본값을 덮어쓴다.
#
# 아래 Credential은 Local 개발 전용이며, 운영 환경이나 공유 환경에서
# 재사용하지 않는다.

# PostgreSQL
POSTGRES_DB=geti
POSTGRES_USER=geti
POSTGRES_PASSWORD=geti-local-only
POSTGRES_PORT=5432

# Redis (Local 개발 전용, 인증 미사용)
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=geti-local
MINIO_ROOT_PASSWORD=geti-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# `docker compose --profile app up -d --build`로 Spring Boot까지 Container로 실행할 때
# Host에 공개할 Port. Host에서 직접 `bootRun`으로 실행할 때는 사용되지 않는다.
SERVER_PORT=8080
